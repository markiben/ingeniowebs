# Plataforma Ingenio Webs
PLATFORM_AUTH_SECRET=cambia-este-secreto-largo
PLATFORM_ADMIN_EMAIL=info@ingeniowebs.com
PLATFORM_ADMIN_PASSWORD=IngenioAdmin2026!
# URL pública del sitio (sin barra final). Necesaria para el redirect de Google OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sign-In (OAuth 2.0) — ver paso a paso en la respuesta del agente / README
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Apps Script (formularios + recupero de contraseña + welcome newsletter)
# Ver scripts/google-apps-script-contact.js
GOOGLE_CONTACT_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Promo automática al suscribirse al newsletter (welcome email)
NEWSLETTER_WELCOME_DISCOUNT_PERCENT=10
NEWSLETTER_WELCOME_PROMO_CODE=BIENVENIDA10

# xAI Grok — chatbot de soporte (solo servidor; nunca NEXT_PUBLIC_)
# https://console.x.ai → API keys
XAI_API_KEY=
# Opcional (default: grok-4.20-0309-non-reasoning — más rápido/barato para chat)
# XAI_MODEL=grok-4.20-0309-non-reasoning
