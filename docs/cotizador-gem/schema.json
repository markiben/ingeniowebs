{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IngenioWebsQuotePayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "client", "project"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "company", "email"],
      "properties": {
        "name": { "type": "string" },
        "company": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "objectives",
        "scope",
        "outOfScope",
        "phases",
        "timelineNote",
        "assumptions",
        "notes"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "summary": { "type": "string" },
        "objectives": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outOfScope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "deliverables", "estimatedHours"],
            "properties": {
              "name": { "type": "string", "minLength": 2 },
              "description": { "type": "string" },
              "deliverables": {
                "type": "array",
                "items": { "type": "string" }
              },
              "estimatedHours": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "timelineNote": { "type": "string" },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
